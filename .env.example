# Application
APP_HOST=0.0.0.0
APP_PORT=8001
DATABASE_PATH=data/callflow.db

# Public URLs used by Twilio. Replace both for a live deployment.
PUBLIC_BASE_URL=https://your-public-domain.example
PUBLIC_WS_URL=wss://your-public-domain.example/ws/conversation

# Dashboard/simulator API. Replace with a long random value outside local demos.
API_KEY=local-demo-key

# Natural live conversation. Optional for the credential-free simulator.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Twilio request verification and warm handoff.
# Keep validation false only for local simulator work where Twilio is not calling.
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=false
HUMAN_AGENT_PHONE=

# Optional best-effort post-call event receiver.
N8N_POST_CALL_WEBHOOK=

# Used only by the optional Docker Compose n8n profile.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
GENERIC_TIMEZONE=UTC
